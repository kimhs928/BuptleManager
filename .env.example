# 사용 방법: 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 git 에 올라가지 않는다)

# docker compose (PostgreSQL 컨테이너)
POSTGRES_DB=buptle_manager
POSTGRES_USER=buptle
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Spring Boot (DB_HOST, DB_PORT, DB_NAME, DB_USERNAME 은 아래 값이 기본값. DB_PASSWORD 는 필수)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buptle_manager
DB_USERNAME=buptle
DB_PASSWORD=change-me

# 운영 배포 시 지정 (미지정이면 local)
# SPRING_PROFILES_ACTIVE=prod
